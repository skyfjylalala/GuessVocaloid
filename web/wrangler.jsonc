{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "guess-vocaloid",
	"main": "server/worker.ts",
	"compatibility_date": "2026-10-18",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "guess-vocaloid",
			// Replace with the ID returned by `pnpm exec wrangler d1 create guess-vocaloid` before deployment.
			"database_id": "891e59ff-fdc4-40af-b76e-1a807657f638",
			"migrations_dir": "migrations"
		},
		{
			"binding": "guess_vocaloid",
			"database_name": "guess-vocaloid",
			"database_id": "891e59ff-fdc4-40af-b76e-1a807657f638"
		}
	],
	"observability": {
		"enabled": true
	}
}